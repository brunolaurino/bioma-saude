# Endereço do ambiente. Sem domínio próprio, use o IP do servidor com sslip.io,
# ex.: para o IP 18.230.10.25 use 18-230-10-25.sslip.io (o certificado HTTPS sai automático).
# Para testar no próprio computador, use: localhost
DOMAIN=localhost

# E-mail para o aviso de vencimento do certificado HTTPS (Let's Encrypt).
ACME_EMAIL=voce@exemplo.com.br

# E-mail de convites (SMTP). Sem isso, os e-mails vão só para o log e o código aparece na tela.
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_FROM_ADDRESS=nao-responda@exemplo.com.br
